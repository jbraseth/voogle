# =============================================================================
# Management UI Image - Core + Streamlit (no ML dependencies)
# Use for: management (Streamlit admin UI)
# =============================================================================

# Stage 1: Builder - Install dependencies with uv
FROM python:3.12-slim-bookworm AS builder

# Install uv for fast dependency installation
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install build dependencies (only needed in builder stage)
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    git \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency files first (better layer caching)
COPY pyproject.toml uv.lock ./

# Install core + management dependencies (NO ML group)
RUN uv sync --frozen --no-install-project --no-dev --group management

# Copy source code
COPY src/ ./src/
COPY bin/ ./bin/

# Install the project itself
RUN uv sync --frozen --no-dev --group management

# =============================================================================
# Stage 2: Runtime - Minimal image with only runtime dependencies
# =============================================================================
FROM python:3.12-slim-bookworm AS runtime

# Prevent Python from buffering stdout/stderr
ENV PYTHONUNBUFFERED=1
# Prevent Python from creating .pyc files
ENV PYTHONDONTWRITEBYTECODE=1
# Add virtual environment to PATH
ENV PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Install only runtime dependencies
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    curl && \
    rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application files
COPY --from=builder /app/src /app/src
COPY --from=builder /app/bin /app/bin

CMD ["streamlit", "run", "src/voogle/management/🏠-Home.py", "--server.port=8501", "--server.address=0.0.0.0"]
