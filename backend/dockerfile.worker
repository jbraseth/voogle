# =============================================================================
# Worker Image - Full ML dependencies for transcription and embedding (~3.5GB)
# Use for: worker (RQ jobs for transcription/embedding)
# For slim API image (~500MB), use dockerfile.api instead
# =============================================================================

# Stage 1: Builder - Install dependencies with uv
FROM python:3.12-slim-bookworm AS builder

# Install uv for fast dependency installation
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install build dependencies (only needed in builder stage)
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    git \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency files first (better layer caching)
COPY pyproject.toml uv.lock ./

# Install dependencies into virtual environment (including ML group)
# --frozen ensures we use exact versions from lock file
# --no-install-project skips installing the project itself (we'll do that after copying source)
# --group ml includes ML dependencies for transcription and embedding
RUN uv sync --frozen --no-install-project --no-dev --group ml

# Copy source code
COPY src/ ./src/
COPY bin/ ./bin/

# Install the project itself (with ML group)
RUN uv sync --frozen --no-dev --group ml

# Replace CUDA PyTorch with CPU-only version (saves ~6GB)
RUN uv pip uninstall torch torchvision torchaudio nvidia-cublas-cu12 nvidia-cuda-cupti-cu12 nvidia-cuda-nvrtc-cu12 nvidia-cuda-runtime-cu12 nvidia-cudnn-cu12 nvidia-cufft-cu12 nvidia-curand-cu12 nvidia-cusolver-cu12 nvidia-cusparse-cu12 nvidia-cusparselt-cu12 nvidia-nccl-cu12 nvidia-nvjitlink-cu12 nvidia-nvtx-cu12 triton 2>/dev/null || true && \
    uv pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# =============================================================================
# Stage 2: Runtime - Minimal image with only runtime dependencies
# =============================================================================
FROM python:3.12-slim-bookworm AS runtime

# Prevent Python from buffering stdout/stderr
ENV PYTHONUNBUFFERED=1
# Prevent Python from creating .pyc files
ENV PYTHONDONTWRITEBYTECODE=1
# Add virtual environment to PATH
ENV PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Install only runtime dependencies (no build tools)
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    curl \
    ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder (includes all Python deps + project)
COPY --from=builder /app/.venv /app/.venv

# Copy application files
COPY --from=builder /app/src /app/src
COPY --from=builder /app/bin /app/bin

RUN chmod +x "/app/bin/entrypoint.sh"

ENTRYPOINT ["/app/bin/entrypoint.sh"]
CMD ["uvicorn", "src.voogle.main:app", "--proxy-headers", "--host", "0.0.0.0", "--port", "80"]

# =============================================================================
# Stage 3: Development - Includes dev + ML dependencies for testing
# =============================================================================
FROM builder AS development

# Install dev dependencies (ML already included from builder stage)
RUN uv sync --frozen --group dev --group ml

# Runtime deps for dev
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    curl \
    ffmpeg && \
    rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="/app/.venv/bin:$PATH"

RUN chmod +x "/app/bin/entrypoint.sh"

ENTRYPOINT ["/app/bin/entrypoint.sh"]
CMD ["uvicorn", "src.voogle.main:app", "--proxy-headers", "--host", "0.0.0.0", "--port", "80", "--reload"]
