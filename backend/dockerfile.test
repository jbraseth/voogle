# Test image with Playwright support
# Using Ubuntu 22.04 for Python 3.10 (PyAV 10.0.0 incompatible with Python 3.12)

FROM docker.io/library/ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /backend

# Install Python 3.10 and system dependencies
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    python3-pip \
    curl \
    git \
    ffmpeg \
    build-essential \
    pkg-config \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev && \
    rm -rf /var/lib/apt/lists/*

# Create python3 symlink
RUN ln -sf /usr/bin/python3.10 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.10 /usr/bin/python

# Install application dependencies first (for better caching)
COPY ./requirements.txt /backend/requirements.txt

# TEMPORARY HACK: Install old Cython and build PyAV without isolation
# PyAV 10.0.0 has Cython compilation errors with modern Cython
RUN python3 -m pip install "Cython<3.0" && \
    python3 -m pip install --no-build-isolation --no-cache-dir av==10.0.0 && \
    python3 -m pip install --no-cache-dir -r /backend/requirements.txt

# Install test dependencies
COPY ./requirements-test.txt /backend/requirements-test.txt
RUN python3 -m pip install --no-cache-dir -r /backend/requirements-test.txt

# Install Playwright browsers (this is the heavy part)
RUN playwright install --with-deps chromium

# Copy application code
COPY . /backend

# Install application in editable mode for tests
RUN pip install -e .[dev]

# Default command runs tests
CMD ["pytest", "-v"]
