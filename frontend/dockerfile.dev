FROM node:19-slim

WORKDIR /frontend

# curl for health checks
RUN apt-get update &&\
    apt-get install --no-install-recommends -y curl &&\
    rm -rf /var/lib/apt/lists/*

# Install dependencies first (cached layer)
COPY ./package.json ./package-lock.json /frontend/
RUN npm install

# Source code mounted at runtime via compose volumes
COPY ./ .

EXPOSE 5173

# Hot reload with Vite HMR (--host binds to 0.0.0.0 for Docker networking)
CMD ["npm", "run", "dev"]
