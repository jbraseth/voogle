# Test image - extends backend with test dependencies

# Build backend first, then extend it
FROM python:3.12-slim-bookworm AS backend-base

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /backend

# Install system dependencies (same as backend)
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    curl \
    git \
    ffmpeg \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

# Install application dependencies
COPY ./backend/requirements.txt /backend/requirements.txt
RUN pip install -U pip && \
    pip install --no-cache-dir -r /backend/requirements.txt

# Copy and install application
COPY ./backend /backend
RUN pip install -e .[dev]

# Test stage - extends backend with test deps
FROM backend-base AS test

# Install CPU-only torch (override any CUDA deps)
RUN pip uninstall -y torch torchvision torchaudio 2>/dev/null || true && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Install test dependencies
COPY ./tests/requirements.txt /backend/requirements-test.txt
RUN pip install --no-cache-dir -r /backend/requirements-test.txt

# Install Playwright browsers
RUN playwright install --with-deps chromium

# Copy test files
COPY ./tests /tests

# Set PYTHONPATH so fixtures module is discoverable
ENV PYTHONPATH=/tests

# Default command runs tests from /tests directory
CMD ["pytest", "/tests", "-v"]
