# Test/CI base image - has all dependencies, code mounted at runtime

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app/tests:/app/src

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    curl \
    git \
    ffmpeg \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

# Install application dependencies
COPY ./backend/requirements.txt /app/requirements.txt
RUN pip install -U pip && \
    pip install --no-cache-dir -r /app/requirements.txt

# Install dev dependencies from pyproject.toml extras
COPY ./backend/pyproject.toml ./backend/setup.cfg /app/
COPY ./backend/src /app/src
RUN pip install -e .[dev]

# Install CPU-only torch (override any CUDA deps)
RUN pip uninstall -y torch torchvision torchaudio 2>/dev/null || true && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Install test dependencies (excluding playwright - e2e tests run separately)
COPY ./tests/requirements.txt /app/requirements-test.txt
RUN pip install --no-cache-dir -r /app/requirements-test.txt

# Working directory for running commands
WORKDIR /workspace

# Default command
CMD ["bash"]
