# Development environment configuration
ENVIRONMENT="development"

REDIS_HOST="redis"

QDRANT_HOST="qdrant"
QDRANT_PORT=6333

# Frontend API configuration
# Browser JavaScript runs on host machine, so always use localhost (not Docker hostname)
VITE_API_HOST="http://localhost"
VITE_API_PORT=81
VITE_API_PREFIX=""

# Security (generate with: openssl rand -hex 32)
SECRET_KEY="a593e426986ac30aad36f9b24e924b059b2278c035dae00ba81ddda02dd01f49"

# Admin credentials (CHANGE IN PRODUCTION!)
ADMIN_USERNAME="voogle-admin"
ADMIN_PASSWORD="*audio*search*engine"

# Port mappings
VOOGLE_FRONTEND_PORT=80
VOOGLE_MANAGEMENT_PORT=8501

# OpenAI Embeddings Configuration (optional)
# If OPENAI_API_KEY is set, uses OpenAI API instead of local sentence-transformers
# Uncomment the line below and add your API key to use OpenAI embeddings
# OPENAI_API_KEY="sk-your-key-here"
# OPENAI_MODEL="text-embedding-3-small"  # Optional: override default model
